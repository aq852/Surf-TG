# Telegram (required)
API_ID=""
API_HASH=""
BOT_TOKEN=""
AUTH_CHANNEL="-1001234567890"
ALLOWED_TELEGRAM_USERS="123456789"
DATABASE_URL="mongodb://mongo:27017"
SESSION_STRING=""

# Additional CDN bots (optional, up to 50)
# MULTI_TOKEN1=""

# Web
BASE_URL="https://surf.example.com"
PORT="8080"
SECRET_KEY="replace-with-at-least-32-random-characters"
COOKIE_SECURE="true"
STREAM_TOKEN_TTL="21600"

# Accounts. Generate hashes with: python -m bot.helper.security
VIEWER_USERNAME="viewer"
PASSWORD_HASH=""
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH=""

# Plain-text fallback is supported for migration only. Never use defaults.
VIEWER_PASSWORD="replace-this-viewer-password"
ADMIN_PASSWORD="replace-this-admin-password"

SLEEP_THRESHOLD="60"
WORKERS="10"
THEME="surf"
HIDE_CHANNEL="false"
