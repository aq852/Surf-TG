# AkMovieVerse example configuration
# Copy this file to config.env. Never commit your real credentials.

# Telegram (required)
API_ID=""
API_HASH=""
BOT_TOKEN=""
AUTH_CHANNEL="-1001234567890"
ALLOWED_TELEGRAM_USERS="123456789"
DATABASE_URL="mongodb://mongo:27017"

# Optional Pyrogram user session for direct history browsing.
SESSION_STRING=""

# Additional streaming bots (optional, MULTI_TOKEN1 through MULTI_TOKEN50).
MULTI_CLIENT="false"
# MULTI_TOKEN1=""

# Web server and signed-link security
BASE_URL="https://movies.example.com"
PORT="8080"
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="replace-with-at-least-32-random-characters"
COOKIE_SECURE="true"
STREAM_TOKEN_TTL="21600"

# Built-in accounts. Generate hashes with: python -m bot.helper.security
VIEWER_USERNAME="viewer"
PASSWORD_HASH=""
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH=""

# Plain-text fallback is supported for migration/local testing only.
# Prefer the hash variables above in production.
VIEWER_PASSWORD="replace-this-viewer-password"
ADMIN_PASSWORD="replace-this-admin-password"

# AkMovieVerse branding and support
SITE_NAME="AkMovieVerse"
SITE_CREDIT="By AkMovieVerse"
SUPPORT_USERNAME="AK_ownerbot"

# Interface: midnight, cinema, ocean, royal, aurora, amoled, graphite, or light
THEME="midnight"
HIDE_CHANNEL="false"

# Optional initial sponsor banner. Admin UI can override these values in MongoDB.
# Leave the poster URL or destination empty to start with the banner disabled.
# Use a Direct Link or your own promotion as AD_URL. A mobile poster is optional.
AD_URL=""
AD_IMAGE_URL=""
AD_MOBILE_IMAGE_URL=""

# Optional extra case-insensitive regex removed from indexed display titles.
# Example: FILENAME_CLEANUP_REGEX="(?i)mychannel|join now"
FILENAME_CLEANUP_REGEX=""

# Runtime tuning
SLEEP_THRESHOLD="60"
WORKERS="10"
